{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "paths": {
    "@shared/*": ["./shared/*"],
    "@providers/*": ["./providers/*"],
    "@eval/*": ["./eval/*"],
    "@loadtest/*": ["./loadtest/*"]
  },
  "workspaces": {
    "realtime": {
      "entry": ["src/db/migrations/*.ts", "scripts/*.ts", "src/**/__tests__/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "web": {
      "entry": ["scripts/*.ts", "src/**/__tests__/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"]
    },
    "widget": {
      "entry": ["scripts/*.mjs", "src/__tests__/*.ts"],
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": [
        "scripts/measure-ttft.mjs",
        "scripts/*.mjs",
        "eval/**/*.ts",
        "loadtest/**/*.ts",
        "shared/**/__tests__/*.ts",
        "providers/**/__tests__/*.ts"
      ],
      "project": [
        "shared/**/*.ts",
        "providers/**/*.ts",
        "eval/**/*.ts",
        "loadtest/**/*.ts",
        "scripts/**/*.mjs"
      ]
    }
  },
  "ignore": ["shared/handoff/protocol.ts", "providers/llm/http.ts"]
}
