{
  "name": "interrelated-realtime",
  "private": true,
  "description": "The data plane: widget chat (SSE), retrieval, ingest worker, and (from M4) the human-handoff WebSocket. CommonJS on purpose — the production artifact is a single esbuild bundle run by plain `node`, and CJS keeps that boring and debuggable.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "enqueue": "tsx scripts/enqueueSource.ts",
    "search": "tsx scripts/searchDev.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --alias:@shared=../shared --alias:@providers=../providers --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "htmlparser2": "^12.0.0",
    "kysely": "^0.28.7",
    "pg": "^8.16.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
