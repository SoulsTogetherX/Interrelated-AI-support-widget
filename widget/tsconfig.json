{
  // As strict as shared/ — and for the same reason with a twist: the widget
  // ships to arbitrary third-party pages, so the type checker is the only
  // reviewer that sees every browser it will run in. @shared/* resolves
  // TYPE-ONLY imports (the AnswerEvent wire protocol); esbuild erases them
  // before bundling, so shared/ contributes zero bytes to the budget.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["./src/**/*.ts", "./vitest.config.ts"]
}
