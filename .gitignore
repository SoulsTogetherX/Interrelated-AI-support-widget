# Dependencies — every package installs its own node_modules; none are committed.
node_modules/

# Build artifacts. dist/ is produced by esbuild (realtime, widget) and next
# build (web); coverage/ by vitest --coverage. All reproducible from source.
# next-env.d.ts is GENERATED by every `next build`/`next dev` and — since
# Next 16 — imports type files inside .next/, so committing it would break
# `tsc --noEmit` on a fresh clone. *.tsbuildinfo is tsc's incremental cache
# (web/'s tsconfig sets "incremental", a Next requirement).
dist/
coverage/
.next/
next-env.d.ts
*.tsbuildinfo

# Secrets. .env holds real credentials (Postgres password, provider keys for
# the demo org, the credential-encryption master key). Only .env.example —
# which documents every variable with a placeholder — is committed.
# .env.neon is the local input file for scripts/check-neon.mjs (credential
# tester) and must likewise never be committed.
.env
.env.local
.env.production
.env.neon

# fastembed's ONNX model cache (~30 MB), created on first local embedding
# run (FASTEMBED_TEST=1 or the eval harness). Machine-local artifact.
local_cache/

# Eval outputs. latest.json is regenerated by every `npm run eval`; the
# COMMITTED artifacts are eval/golden.jsonl, eval/floor.json, and
# eval/RESULTS.md — measurements someone chose to publish, not run droppings.
eval/results/

# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
.DS_Store

# Private working notes — deliberately NOT committed, so candid per-phase
# commentary never reaches the public repo. Same convention as OnlineWhiteboard.
PHASE_NOTES.md

# Probe fixtures (M6). Written by `npm run seed-security` / the compose
# probe seed service and read by scripts/security-probe.mjs and
# scripts/injection-probe.mjs. Per-run droppings, like eval/results/.
.probe/
