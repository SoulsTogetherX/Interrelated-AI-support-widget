{
  // Next.js dialect, strict like every other package. The Next-mandated
  // options are exactly that — mandated: `next build` REWRITES this file when
  // they drift ("jsx: react-jsx" — Next 16 uses the React automatic runtime;
  // "moduleResolution: bundler"; "allowJs"; "incremental"; the "next"
  // language-service plugin), so fighting its formatting or choices is churn.
  // The strictness extras (noUnused*, noFallthroughCasesInSwitch, strict) are
  // ours and Next preserves them. "noEmit" because next build owns emitting;
  // `tsc --noEmit` is the fast standalone gate.
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "incremental": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "../shared/*"
      ],
      // shared/ has no package.json by design (CLAUDE.md 2.4), so its
      // TYPE-ONLY `import type { ColumnType } from "kysely"` resolves by
      // walking up from shared/ — which finds the ROOT node_modules
      // locally and in CI, and finds NOTHING on Vercel, where only web/ is
      // installed. web/ declares kysely itself, so this mapping points the
      // bare specifier at that copy for every file the program includes,
      // wherever it sits. Without it `next build` fails on Vercel with
      // "Cannot find module 'kysely'" from ../shared/db/schema.ts while
      // every local and CI typecheck passes.
      "kysely": [
        "./node_modules/kysely"
      ]
    },
    "allowJs": true
  },
  // next-env.d.ts and the .next/ globs are all GENERATED (and gitignored):
  // since Next 16, next-env.d.ts imports type files inside .next/, so it can
  // only exist after a `next build`/`next dev`. On a fresh clone every one of
  // these include entries matches nothing — legal for tsc — and `tsc
  // --noEmit` still typechecks src/ fully; the generated route types are
  // additionally checked by `next build`'s own TypeScript pass, which is why
  // CI runs the build and not only the typecheck.
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
